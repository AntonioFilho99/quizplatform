# Copie para .env (que NÃO vai ao Git) e preencha. Em produção, cadastre no painel do servidor.
DEBUG=1
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=

# Banco PostgreSQL (ex.: Neon). Vazio = SQLite local.
DATABASE_URL=

# IA (provedor de sua escolha; padrão: API Messages da Anthropic)
AI_API_KEY=
AI_API_URL=https://api.anthropic.com/v1/messages
AI_MODEL=claude-haiku-5-5

PERGUNTAS_POR_RODADA=10
